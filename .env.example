# Global
NODE_ENV=development

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API
API_PORT=3001
API_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weddingos
