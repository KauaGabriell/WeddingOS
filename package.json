{
  "name": "weddingos",
  "version": "0.1.0",
  "private": true,
  "description": "WeddingOS monorepo",
  "workspaces": ["apps/*", "packages/*", "tools/*"],
  "scripts": {
    "install:clean": "powershell -ExecutionPolicy Bypass -File ./tools/install-deps.ps1",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint:code && npm run typecheck",
    "lint:code": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --organize-imports-enabled=false .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.15.21",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit $1"
  }
}
