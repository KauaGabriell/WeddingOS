{
  "name": "@weddingos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src/main.ts src/main.test.ts src/modules package.json tsconfig.json tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && node dist/main.test.js",
    "storage:smoke": "tsx src/modules/shared/platform/storage/s3-storage-client.smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/s3-request-presigner": "^3.908.0",
    "@prisma/client": "^7.8.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^9.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  }
}
