#API SERVER
API_PORT=
API_HOST=

#DATABASE
# DEV ONLY (use valores reais em staging/prod via secret manager)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=db

#S3 STORAGE
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=weddingos-photos
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_IN_SECONDS=900

#AUTH
JWT_SECRET=CHANGE_ME_JWT_SECRET
