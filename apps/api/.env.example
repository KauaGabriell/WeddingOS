# API app env template
# Required integrations:
# - PostgreSQL
# - Cloudinary media storage
# Required secrets:
# - POSTGRES_PASSWORD
# - CLOUDINARY_API_KEY
# - CLOUDINARY_API_SECRET
# - JWT_SECRET
# Keep real values in secret manager outside development.

# Shared runtime
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Development example
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/weddingos?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=weddingos
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=weddingos-dev
CLOUDINARY_SIGNED_URL_EXPIRES_IN_SECONDS=900
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# Staging reference
# Real secrets must come from secret manager, never from committed env files.
# API_PUBLIC_URL=https://api-staging.weddingos.app
# CORS_ORIGIN=https://staging.weddingos.app
# DATABASE_URL=postgresql://weddingos:CHANGE_ME_DB_PASSWORD@staging-db:5432/weddingos?schema=public
# POSTGRES_USER=weddingos
# POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# POSTGRES_DB=weddingos
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME
# CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
# CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET
# CLOUDINARY_FOLDER=weddingos-staging
# CLOUDINARY_SIGNED_URL_EXPIRES_IN_SECONDS=900
# JWT_SECRET=CHANGE_ME_JWT_SECRET_FROM_SECRET_MANAGER

# Production reference
# Use isolated DB, isolated bucket, isolated secrets.
# NODE_ENV=production
# API_PUBLIC_URL=https://api.weddingos.app
# CORS_ORIGIN=https://weddingos.app
# DATABASE_URL=postgresql://weddingos:CHANGE_ME_DB_PASSWORD@prod-db:5432/weddingos?schema=public
# POSTGRES_USER=weddingos
# POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# POSTGRES_DB=weddingos
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME
# CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
# CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET
# CLOUDINARY_FOLDER=weddingos
# CLOUDINARY_SIGNED_URL_EXPIRES_IN_SECONDS=900
# JWT_SECRET=CHANGE_ME_JWT_SECRET_FROM_SECRET_MANAGER

# Optional S3 fallback (legacy)
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=weddingos-media-dev
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_SIGNED_URL_EXPIRES_IN_SECONDS=900
